# =====================================================================
# TruthGuard - Environment Configuration
# =====================================================================

# Primary LLM Provider: "OpenAI" or "Anthropic"
# (If left empty, TruthGuard can run with either key or use the built-in Deterministic Engine)
LLM_PROVIDER=OpenAI

# OpenAI API Key (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Anthropic API Key (Claude 3.5 Sonnet / Claude 3 Haiku)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Vector Store Persistence Directory
CHROMA_PERSIST_DIR=./chroma_db
